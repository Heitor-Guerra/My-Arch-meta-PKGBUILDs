// Gram keymap
//
// For information on binding keys, see the Gram
// documentation: gram://docs/key-bindings
//
// To see the default key bindings run `gram: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-s": "workspace::Save"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "shift-s": "workspace::SaveAs"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-s": "workspace::SaveAll"
    }
  },
  {
    "context": "((Editor && jupyter) && !ContextEditor)",
    "bindings": {
      "shift-enter": "repl::Run"
    }
  },
  {
    "bindings": {
      "ctrl-/": "editor::ToggleComments"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-f": "pane::DeploySearch"
    }
  },
  {
    "bindings": {
      "ctrl-f": "buffer_search::Deploy"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-shift-f": null
    }
  },
  {
    "bindings": {
      "alt-down": "editor::AddSelectionBelow"
    }
  },
  {
    "bindings": {
      "alt-up": "editor::AddSelectionAbove"
    }
  },
  {
    "bindings": {
      "alt-j": "editor::SelectPrevious"
    }
  },
  {
    "bindings": {
      "alt-k": "editor::SelectNext"
    }
  },
  {
    "bindings": {
      "alt-l": "editor::SelectAllMatches"
    }
  }
]
